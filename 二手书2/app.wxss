page { background: #fffaf1; color: #23332e; font-family: -apple-system-font, BlinkMacSystemFont, "Microsoft YaHei", sans-serif; }
.page { padding: 24rpx 32rpx 48rpx; }
.eyebrow { color: #1f8f68; font-size: 22rpx; letter-spacing: 2rpx; }
h1 { margin: 10rpx 0 28rpx; font-size: 48rpx; color: #183f35; }
h2 { margin: 28rpx 0 18rpx; font-size: 36rpx; } h3 { margin: 0; font-size: 30rpx; }
.search { background: white; border: 1rpx solid #e6eee9; border-radius: 24rpx; padding: 20rpx 24rpx; box-shadow: 0 12rpx 30rpx rgba(28,88,67,.08); }
.search input { width: 90%; display: inline-block; margin-left: 14rpx; }
.chips { white-space: nowrap; margin: 24rpx 0; } .chip { display: inline-block; margin-right: 14rpx; padding: 14rpx 24rpx; border-radius: 40rpx; background: white; color: #7a8b85; }
.chip.active { color: white; background: #1f8f68; }
.grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; }
.book { background: white; border-radius: 24rpx; overflow: hidden; box-shadow: 0 12rpx 30rpx rgba(28,88,67,.08); }
.cover { height: 220rpx; display: flex; align-items: center; justify-content: center; padding: 20rpx; text-align: center; color: white; font-size: 30rpx; font-weight: bold; background: linear-gradient(145deg,#6cc39e,#2a8f6d); }
.book:nth-child(3n) .cover { background: linear-gradient(145deg,#f4bb75,#df8055); }
.book-info { padding: 20rpx; } .book-info text { display: block; margin-top: 10rpx; color: #7a8b85; font-size: 22rpx; }
.price { color: #e77943; font-size: 34rpx; font-weight: bold; }
.nearby { margin-top: 28rpx; padding: 24rpx; border-radius: 24rpx; background: #183f35; color: white; }
.card { margin-bottom: 24rpx; padding: 26rpx; border-radius: 24rpx; background: white; box-shadow: 0 12rpx 30rpx rgba(28,88,67,.08); }
label { display: block; margin: 22rpx 0 10rpx; color: #7a8b85; font-size: 24rpx; } input, textarea, picker { width: 100%; padding: 20rpx; border: 1rpx solid #e6eee9; border-radius: 16rpx; background: #fbfdfb; }
textarea { min-height: 150rpx; }
.btn { margin-top: 24rpx; border-radius: 16rpx; color: white; background: #1f8f68; } .btn.danger { color: #c75b4d; background: #fff0ed; }
.muted { color: #7a8b85; font-size: 24rpx; } .tag { display: inline-block; margin: 8rpx 8rpx 8rpx 0; padding: 8rpx 12rpx; border-radius: 10rpx; color: #1f8f68; background: #e9f7f0; font-size: 22rpx; }
.row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; } .status { color: #1f8f68; font-weight: bold; }
.stat-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 16rpx; } .stat strong { display: block; margin-top: 8rpx; font-size: 38rpx; color: #183f35; }
