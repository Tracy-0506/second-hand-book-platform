<view class="page"><text class="eyebrow">发布后立即展示</text><h1>发布一本书</h1><form bindsubmit="submit"><view class="card"><label>书名</label><input name="title" required placeholder="例如：高等数学（上册）" /><label>售价（元）</label><input name="price" type="digit" required placeholder="请输入价格" /><label>新旧程度</label><picker name="condition" mode="selector" range="{{conditions}}" value="{{conditionIndex}}" bindchange="chooseCondition"><view>{{conditions[conditionIndex]}}</view></picker><label>所在学校</label><picker name="school" mode="selector" range="{{schools}}" value="{{schoolIndex}}" bindchange="chooseSchool"><view>{{schools[schoolIndex]}}</view></picker><label>校区</label><input name="campus" value="南山校区" /><label>备注</label><textarea name="note" placeholder="填写划线、笔记和面交说明"></textarea><button class="btn" form-type="submit">立即发布</button></view></form></view>
