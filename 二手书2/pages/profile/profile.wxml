<view class="page"><text class="eyebrow">校园账户</text><h1>我的</h1><view class="card"><h2>{{phone ? '我的校园账户' : '尚未登录'}}</h2><text class="muted">{{phone ? '手机号：' + phone : '登录后可以发布和购买书籍'}}</text><button wx:if="{{!phone}}" class="btn" bindtap="login">手机号登录</button><view wx:if="{{phone}}"><text class="tag">信用良好</text><text class="tag">交易完成 {{completed}} 笔</text></view></view><view class="stat-grid"><view class="card stat"><text class="muted">我的发布</text><strong>{{myBooks}}</strong></view><view class="card stat"><text class="muted">购买订单</text><strong>{{orders}}</strong></view><view class="card stat"><text class="muted">平台抽成</text><strong>15%</strong></view></view><view class="card"><h3>演示管理员后台</h3><text class="muted">正式上线前需要替换为真实管理员权限。</text><button class="btn" bindtap="admin">进入管理员后台</button></view></view>
