<view class="page"><text class="eyebrow">ADMIN CONSOLE</text><h1>管理员后台</h1><view class="stat-grid"><view class="card stat"><text class="muted">商品总数</text><strong>{{books.length}}</strong></view><view class="card stat"><text class="muted">订单总数</text><strong>{{orders.length}}</strong></view><view class="card stat"><text class="muted">平台收入</text><strong>¥{{revenue}}</strong></view></view><h2>商品管理</h2><view wx:for="{{books}}" wx:key="id" class="card"><view class="row"><view><h3>{{item.title}}</h3><text class="muted">{{item.school}} · ¥{{item.price}}</text></view><button class="btn danger" data-id="{{item.id}}" bindtap="removeBook">删除</button></view></view><h2>订单退款</h2><view wx:for="{{orders}}" wx:key="id" class="card"><view class="row"><view><h3>{{item.title}}</h3><text class="muted">{{item.status}} · 服务费 ¥{{item.fee}}</text></view><button wx:if="{{item.status === '待面交'}}" class="btn danger" data-id="{{item.id}}" bindtap="refund">同意退款</button></view></view><h2>学校列表</h2><view wx:for="{{schools}}" wx:key="*this" class="card"><text>{{item}}</text><text class="tag">已启用</text></view></view>
