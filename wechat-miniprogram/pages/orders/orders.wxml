<view class="page"><text class="eyebrow">线下面交订单</text><h1>我的订单</h1><view wx:if="{{!orders.length}}" class="card"><text class="muted">还没有订单，去首页逛逛吧。</text></view><view wx:for="{{orders}}" wx:key="id" class="card"><view class="row"><h3>{{item.title}}</h3><text class="status">{{item.status}}</text></view><text class="muted">{{item.school}} · 卖家：{{item.seller}}</text><view class="row"><text>订单金额</text><text class="price">¥{{item.amount}}</text></view><text wx:if="{{item.status === '待面交'}}" class="muted">联系电话：{{item.phone}}</text><button wx:if="{{item.status === '待面交'}}" class="btn" data-id="{{item.id}}" bindtap="complete">完成面交，确认收货</button><button wx:if="{{item.status === '待面交'}}" class="btn danger" data-id="{{item.id}}" bindtap="refund">面交前申请退款</button></view></view>
