<view class="page"><text class="eyebrow">校园循环 · 重庆南山</text><h1>二手书平台</h1><view class="search">⌕<input placeholder="搜索书名" bindinput="onSearch" /></view><scroll-view class="chips" scroll-x><text wx:for="{{schools}}" wx:key="*this" class="chip {{item === school ? 'active' : ''}}" data-school="{{item}}" bindtap="changeSchool">{{item}}</text></scroll-view><view class="row"><h2>我的学校市场</h2><text class="muted">{{school}}</text></view><view class="grid"><block wx:for="{{mineBooks}}" wx:key="id"><view class="book" data-id="{{item.id}}" bindtap="openBook"><view class="cover">{{item.title}}</view><view class="book-info"><h3>{{item.title}}</h3><text>{{item.condition}} · {{item.campus}}</text><text class="price">¥{{item.price}}</text></view></view></block></view><view class="nearby"><view class="row"><h2>附近学校</h2><text>南山周边校园书市</text></view><view class="grid"><block wx:for="{{nearbyBooks}}" wx:key="id"><view class="book" data-id="{{item.id}}" bindtap="openBook"><view class="cover">{{item.title}}</view><view class="book-info"><h3>{{item.title}}</h3><text>{{item.school}} · {{item.condition}}</text><text class="price">¥{{item.price}}</text></view></view></block></view></view></view>
